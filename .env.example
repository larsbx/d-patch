# Configuration contract (Section 31). Names and safe development defaults only;
# this file never carries a real secret. Secrets are loaded at runtime and are
# never committed or embedded in an image.

# --- core -------------------------------------------------------------------
DATABASE_URL=ecto://dispatch:dispatch@localhost:5432/dispatch_dev
PUBLIC_BASE_URL=http://localhost:4000
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# Bearer token guarding /health/dependencies. At least 32 bytes.
DIAGNOSTICS_TOKEN=

# --- identity provider (Section 23.1) ---------------------------------------
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID_API=dispatch-api
OIDC_AUDIENCE=dispatch-api

# --- role profiles (Section 23.2) -------------------------------------------
# Comma-separated compiled modules permitted in role_definitions.profile_module.
# Startup fails if a seeded or active definition references anything else.
ROLE_PROFILE_MODULE_ALLOWLIST=Dispatch.Access.Roles.Driver,Dispatch.Access.Roles.Admin,Dispatch.Access.Roles.Dispatcher,Dispatch.Access.Roles.Shipper,Dispatch.Access.Roles.Receiver,Dispatch.Access.Roles.Broker

# PKCS#8 P-256 private key (PEM) signing the Android capability document
# (ADR-0009). Unset outside production uses the published development key in
# infra/capability-signing/; production refuses that key and requires this.
CAPABILITY_SIGNING_KEY=

# --- break-glass (Section 23.4) ---------------------------------------------
BREAKGLASS_ENABLED=false
# Must be between 60 and 3600. Default 1800.
BREAKGLASS_MAX_TTL_SECONDS=1800
# Must be distinct from each other in production.
BREAKGLASS_REQUESTER_ENTITLEMENT=BREAKGLASS_REQUESTER
BREAKGLASS_APPROVER_ENTITLEMENT=BREAKGLASS_APPROVER
BREAKGLASS_RUNBOOK_ALLOWLIST=
# Production startup fails when this is true.
BREAKGLASS_NONPROD_SINGLE_USER_MODE=true

# --- face verification (Sections 7, 25.6) -----------------------------------
# Stays false until the Section 7.7 provider/model, presentation-attack,
# accessibility, demographic-performance, consent, and jurisdiction gates are
# documented as approved.
FACE_1_TO_1_ENABLED=false
FACE_VERIFIER_ADAPTER=Dispatch.Identity.Face.DisabledVerifier
FACE_POLICY_MANIFEST_PUBLIC_KEY=
FACE_ATTESTATION_RETENTION_DAYS=
FACE_CONSENT_TEXT_VERSION=
FACE_JURISDICTION_POLICY_VERSION=
# Must be between 30 and 120.
FACE_CHALLENGE_TTL_SECONDS=120

# --- communications adapters (Section 27) -----------------------------------
# Selected independently. Twilio variables are required only for channels
# assigned to a Twilio adapter.
COMMS_VOICE_ADAPTER=Dispatch.Integrations.Comms.Unconfigured.Voice
COMMS_VOICE_MEDIA_ADAPTER=Dispatch.Integrations.Comms.Unconfigured.VoiceMedia
COMMS_MESSAGING_ADAPTER=Dispatch.Integrations.Comms.Unconfigured.Messaging
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_CONVERSATION_RELAY_WS_URL=

# --- geospatial adapters (Section 28) ---------------------------------------
GEO_GEOCODER_ADAPTER=Dispatch.Integrations.Geo.Unconfigured.Geocoder
GEO_ROUTER_ADAPTER=Dispatch.Integrations.Geo.Unconfigured.Router
# One of: google, maplibre
MAP_PRESENTATION_PROVIDER=google
GOOGLE_MAPS_SERVER_CREDENTIAL=

# --- agent runtime (Section 29) ---------------------------------------------
# Selected independently. Hermes variables are required only when a Hermes
# adapter is selected.
AGENT_RUNTIME_ADAPTER=Dispatch.Integrations.Agent.Fake.Runtime
AGENT_STREAMING_RUNTIME_ADAPTER=Dispatch.Integrations.Agent.Fake.StreamingRuntime
HERMES_BASE_URL=
HERMES_SERVICE_TOKEN=

# --- encryption (Section 13) ------------------------------------------------
APPLICATION_ENCRYPTION_KEY_ID=
