{
  "components": {
    "responses": {},
    "schemas": {
      "DependenciesResponse": {
        "additionalProperties": false,
        "properties": {
          "adapters": {
            "properties": {
              "ports": {
                "additionalProperties": true,
                "type": "object"
              },
              "required_secrets": {
                "additionalProperties": {
                  "type": "boolean"
                },
                "description": "Presence only; values are never reported.",
                "type": "object"
              }
            },
            "required": [
              "ports",
              "required_secrets"
            ],
            "type": "object"
          },
          "checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at",
          "adapters"
        ],
        "title": "DependenciesResponse",
        "type": "object"
      },
      "HealthCheck": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "Stable reason code when failing",
            "type": "string"
          },
          "pending": {
            "type": "integer"
          },
          "postgis_version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthCheck",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable non-sensitive reason code",
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlation_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheck"
            },
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Machine API for the field application and internal services.\n\nPortal endpoints under `/ui` return HTML or Datastar SSE and are not\ndescribed here; Section 24.5 keeps them separate from the `/v1` machine\nAPI on purpose.\n",
    "title": "Dispatch Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/dependencies": {
      "get": {
        "callbacks": {},
        "description": "Redacted adapter selection and secret presence. Never reports secret values.",
        "operationId": "DispatchWeb.HealthController.dependencies",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependenciesResponse"
                }
              }
            },
            "description": "Configuration"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Adapter configuration",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "callbacks": {},
        "description": "Reports that the process is running. Asserts nothing about dependencies.",
        "operationId": "DispatchWeb.HealthController.live",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Liveness"
          }
        },
        "summary": "Process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "callbacks": {},
        "description": "Database reachability and migration state. Makes no outbound provider call.",
        "operationId": "DispatchWeb.HealthController.ready",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Ready"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  },
  "security": [],
  "servers": [
    {
      "url": "/",
      "variables": {}
    }
  ],
  "tags": []
}
